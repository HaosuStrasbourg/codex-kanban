{
  "name": "codex-pm",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "eval": "vitest run",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node --experimental-strip-types scripts/build.mts",
    "cpm": "node --experimental-strip-types scripts/cpm.mts",
    "test:release": "node --test tests/release.test.mjs",
    "test:package": "node --experimental-strip-types scripts/check-release.mts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "version": "0.3.3-preview.1",
  "license": "MIT"
}
